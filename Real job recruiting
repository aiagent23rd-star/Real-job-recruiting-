<!-- NAVIGATION -->

<nav>
  <div class="logo">
    Job<span>Recruit</span>
  </div>

  <ul class="nav-links">
    <li><a href="#home">Home</a></li>
    <li><a href="#how">How It Works</a></li>
    <li><a href="#apply">Apply</a></li>
    <li><a href="#contact">Contact</a></li>
    <li>
      <a class="nav-button" href="#apply">Find a Job</a>
    </li>
  </ul>
</nav>


<!-- HERO -->

<header class="hero" id="home">

  <div class="hero-container">

    <div>

      <div class="badge">
        Career & Recruitment Support
      </div>

      <h1>
        Your next career opportunity
        <span>starts here.</span>
      </h1>

      <p>
        Tell us about your experience, skills and career goals.
        Submit your details and CV so we can understand what
        kind of opportunity you are looking for.
      </p>

      <div class="hero-buttons">

        <a class="primary-btn" href="#apply">
          Find Your Next Job →
        </a>

        <a class="secondary-btn" href="#how">
          How It Works
        </a>

      </div>

    </div>


    <div class="hero-card">

      <div class="profile-icon">
        ✓
      </div>

      <h3>
        Career Profile
      </h3>

      <p>
        Create your professional job-seeker profile
        and tell us what type of opportunity you are
        looking for.
      </p>

      <div class="mini-box">
        <strong>✓ Skills & Experience</strong>
        <br>
        Help us understand your professional background.
      </div>

      <div class="mini-box">
        <strong>✓ CV Submission</strong>
        <br>
        Upload your latest CV for review.
      </div>

      <div class="mini-box">
        <strong>✓ Recruitment Support</strong>
        <br>
        Contact our recruitment team through WhatsApp.
      </div>

    </div>

  </div>

</header>


<!-- HOW IT WORKS -->

<section class="features" id="how">

  <div class="section-header">

    <h2>How It Works</h2>

    <p>
      A simple process for job seekers to introduce
      themselves and their career goals.
    </p>

  </div>


  <div class="feature-grid">

    <div class="feature-card">

      <div class="feature-number">01</div>

      <h3>Complete Your Profile</h3>

      <p>
        Tell us your name, location, skills,
        experience and the type of job you are seeking.
      </p>

    </div>


    <div class="feature-card">

      <div class="feature-number">02</div>

      <h3>Submit Your CV</h3>

      <p>
        Provide your CV or resume and additional
        information that can help with your job search.
      </p>

    </div>


    <div class="feature-card">

      <div class="feature-number">03</div>

      <h3>Contact Recruitment</h3>

      <p>
        After submitting your information,
        contact our recruitment team directly through WhatsApp.
      </p>

    </div>

  </div>

</section>


<!-- APPLICATION -->

<section class="application" id="apply">

  <div class="application-container">

    <h2>Start Your Job Search</h2>

    <p>
      Complete the form below with accurate information.
    </p>


    <!--
      IMPORTANT:
      Replace YOUR_FORMSPREE_ENDPOINT below with
      your actual Formspree form endpoint.
    -->

    <form
      action="https://formspree.io/f/YOUR_FORMSPREE_ENDPOINT"
      method="POST"
      enctype="multipart/form-data"
    >

      <div class="form-grid">

        <div class="form-group">

          <label for="name">
            Full Name *
          </label>

          <input
            id="name"
            name="Full Name"
            type="text"
            placeholder="Enter your full name"
            required
          >

        </div>


        <div class="form-group">

          <label for="email">
            Email Address *
          </label>

          <input
            id="email"
            name="Email"
            type="email"
            placeholder="you@example.com"
            required
          >

        </div>


        <div class="form-group">

          <label for="phone">
            Phone / WhatsApp *
          </label>

          <input
            id="phone"
            name="Phone / WhatsApp"
            type="tel"
            placeholder="+234..."
            required
          >

        </div>


        <div class="form-group">

          <label for="location">
            Current Location *
          </label>

          <input
            id="location"
            name="Location"
            type="text"
            placeholder="City, Country"
            required
          >

        </div>


        <div class="form-group">

          <label for="job">
            Job You Are Looking For *
          </label>

          <input
            id="job"
            name="Job Desired"
            type="text"
            placeholder="e.g. Accountant, Designer, Developer"
            required
          >

        </div>


        <div class="form-group">

          <label for="experience">
            Years of Experience
          </label>

          <select id="experience" name="Experience">

            <option value="">
              Select experience
            </option>

            <option>Less than 1 year</option>
            <option>1 - 2 years</option>
            <option>3 - 5 years</option>
            <option>6 - 10 years</option>
            <option>10+ years</option>

          </select>

        </div>


        <div class="form-group full">

          <label for="skills">
            Skills
          </label>

          <input
            id="skills"
            name="Skills"
            type="text"
            placeholder="e.g. Excel, Graphic Design, Marketing, Sales"
          >

        </div>


        <div class="form-group full">

          <label for="education">
            Education / Qualification
          </label>

          <input
            id="education"
            name="Education"
            type="text"
            placeholder="Enter your highest qualification"
          >

        </div>


        <div class="form-group full">

          <label for="cv">
            Upload CV / Resume
          </label>

          <input
            id="cv"
            name="CV"
            type="file"
            accept=".pdf,.doc,.docx"
          >

        </div>


        <div class="form-group full">

          <label for="message">
            Tell Us About Yourself
          </label>

          <textarea
            id="message"
            name="Additional Message"
            placeholder="Briefly describe your career goals, experience and the type of opportunity you are looking for..."
          ></textarea>

        </div>


        <button
          type="submit"
          class="submit-button"
        >
          Submit My Job Profile →
        </button>


        <div class="privacy-note">

          By submitting this form, you confirm that the
          information provided is accurate and may be used
          for recruitment-related communication.

        </div>

      </div>

    </form>

  </div>

</section>


<!-- CONTACT -->

<section class="contact" id="contact">

  <h2>Ready to Take the Next Step?</h2>

  <p>
    After submitting your job profile, contact our recruitment
    team directly on WhatsApp so we can communicate with you.
  </p>

  <div class="contact-buttons">

    <a
      class="whatsapp-btn"
      href="https://wa.me/2349067482591"
      target="_blank"
    >
      💬 WhatsApp: 09067482591
    </a>


    <a
      class="email-btn"
      href="mailto:jobrecruitcprw@gmail.com"
    >
      ✉ jobrecruitcprw@gmail.com
    </a>

  </div>

</section>


<!-- FOOTER -->

<footer>

  <p>
    © 2026 <strong>JobRecruit</strong>.
    Career & Recruitment Support.
  </p>

  <p>
    Professional recruitment support for job seekers.
  </p>

</footer>

</body>
